# ==================== 服务端配置 ====================

# 服务端口
PORT=3000

# 运行模式: single(单用户) | multi(多用户/JWT)
AUTH_MODE=single

# 单用户模式的固定访问 Token（前端请求时 Header 带 Authorization: Bearer 此值）
# 前端 VITE_SERVER_TOKEN 必须与此值保持一致，否则所有请求会 401
SINGLE_USER_TOKEN=moss-local-dev-token-2026

# 多用户模式下使用的 JWT 密钥（AUTH_MODE=multi 时生效）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ==================== AI 供应商 Key（服务端托管，前端看不到） ====================
# 留空则该供应商不可用；前端传 provider 名称来选择
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DOUBAO_API_KEY=
QWEN_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=

# ==================== 可选：默认回退供应商 ====================
# 当前端没传 provider 时使用哪个
DEFAULT_PROVIDER=deepseek
DEFAULT_MODEL=deepseek-chat
